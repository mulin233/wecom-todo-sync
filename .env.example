# 复制为 .env 后按需修改：docker compose 会自动读取。
# 这里的值优先于 config.json 中对应字段（留空则忽略，仍然用 config.json）。

# ---- 飞书应用（可留空，改成在 config.json 里填）----
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_ASSIGNEE_OPEN_ID=
FEISHU_TASKLIST_GUID=
# 飞书国际版（Lark）填 https://open.larksuite.com
# FEISHU_BASE_URL=

# ---- 同步节奏 ----
# 两次同步之间的间隔（秒）：300 = 每 5 分钟
SYNC_INTERVAL_SECONDS=300
# 1 = 容器启动时先跑一轮；0 = 等第一个间隔再跑
SYNC_ON_START=1

# ---- 运行环境 ----
TZ=Asia/Shanghai
# 容器运行身份（对应宿主机 ./data 等目录的属主）。root 最省事；
# 桌面 Linux 可改为 PUID=1000、PGID=1000（用 id -u / id -g 查）
PUID=0
PGID=0

# ---- OAuth 回调 ----
# Docker 端口映射下的 OAuth 回调监听地址，保持 0.0.0.0
FEISHU_OAUTH_BIND=0.0.0.0

# 提示：镜像构建参数（BASE_IMAGE / APT_MIRROR / NPM_REGISTRY / WECOM_CLI_VERSION）
# 由 ./build.sh 读取，不经过 docker compose；用法见 README。